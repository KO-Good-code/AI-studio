# Ollama 本地大模型配置
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2

# 智谱 AI 配置
# 国内控制台与 Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
# API 根路径（须以 /api/paas/v4 结尾，可带或不带末尾 /）
# 国内默认: https://open.bigmodel.cn/api/paas/v4/
# 海外示例: https://api.z.ai/api/paas/v4/
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4/
# 海外 curl 中的 Accept-Language（可选）
# ZHIPU_ACCEPT_LANGUAGE=en-US,en

# MCP：推荐用根目录 mcp.config.json（复制 mcp.config.example.json）
# 或指定文件：MCP_CONFIG_FILE=./config/mcp.json
#
# 无文件时可用环境变量：
# MCP_SERVER / MCP_HTTP_URL / MCP_SERVERS（见 docs/MCP.md）
#
# MCP JSON-RPC 超时（毫秒）。默认 180000。uvx 首次下载依赖时若仍超时可调大。
# MCP_REQUEST_TIMEOUT_MS=300000

# Tushare Pro（可选）。配置后 aShareQuote 工具优先走 Tushare 日线/周月线及收盘口径快照
# 注册与积分: https://tushare.pro/register
# TUSHARE_TOKEN=你的token
