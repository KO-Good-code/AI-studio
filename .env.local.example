# Ollama 本地大模型配置
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2

# 智谱 AI 配置
# 获取 API Key: https://open.bigmodel.cn/
# 注册后在"API Keys"页面创建新的 API Key
ZHIPU_API_KEY=your_zhipu_api_key_here

# MCP：推荐用根目录 mcp.config.json（复制 mcp.config.example.json）
# 或指定文件：MCP_CONFIG_FILE=./config/mcp.json
#
# 无文件时可用环境变量：
# MCP_SERVER / MCP_HTTP_URL / MCP_SERVERS（见 docs/MCP.md）
